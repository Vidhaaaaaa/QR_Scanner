<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR Scanner"
        android:textColor="#242129"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan and manage your QR codes"
        android:textColor="#77727D"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"/>

    <!-- Result Card -->

    <androidx.cardview.widget.CardView
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN RESULT"
                android:textColor="#6C4AB6"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/resultType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Website"
                android:textColor="#77727D"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://www.example.com"
                android:textColor="#242129"
                android:textSize="17sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnOpen"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Open Link"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#6C4AB6"
        app:layout_constraintTop_toBottomOf="@id/resultCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnCopy"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Copy to Clipboard"
        android:textColor="#6C4AB6"
        android:backgroundTint="#E9E2F7"
        app:layout_constraintTop_toBottomOf="@id/btnOpen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnShare"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Share"
        android:textColor="#6C4AB6"
        android:backgroundTint="#E9E2F7"
        app:layout_constraintTop_toBottomOf="@id/btnCopy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>