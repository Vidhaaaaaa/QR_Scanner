<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FA">

    <TextView
        android:id="@+id/scannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan QR Code"
        android:textColor="#242129"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"/>

    <TextView
        android:id="@+id/scannerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Point your camera at a QR code"
        android:textColor="#77727D"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/scannerTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="5dp"/>

    <!-- Camera Preview Placeholder -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cameraCard"
        android:layout_width="0dp"
        android:layout_height="390dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#242129"
        app:layout_constraintTop_toBottomOf="@id/scannerSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="25dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAMERA"
                android:textColor="#AFA9B8"
                android:textSize="13sp"
                android:layout_gravity="center"/>

            <!-- Scanning frame -->

            <View
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/scanner_frame"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Align the QR code inside the frame"
                android:textColor="#E5E1E9"
                android:textSize="13sp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="30dp"/>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnGallery"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Scan from Gallery"
        android:textColor="#6C4AB6"
        android:textStyle="bold"
        android:backgroundTint="#E9E2F7"
        app:layout_constraintTop_toBottomOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="18dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>